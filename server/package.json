{
  "name": "@field-battle/server",
  "version": "0.1.0",
  "description": "Strategic board-style soccer card game with zone-based gameplay",
  "type": "module",
  "main": "src/cli/index.js",
  "scripts": {
    "start": "node src/cli/index.js",
    "server": "node src/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "node src/cli/simulate.js multi 10",
    "simulate:single": "node src/cli/simulate.js single",
    "simulate:many": "node src/cli/simulate.js multi 100",
    "scrape": "node scripts/scrape_ea_players.js",
    "scrape:test": "node scripts/scrape_ea_players.js --pages 1"
  },
  "keywords": [
    "game",
    "soccer",
    "card-game",
    "strategy"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "puppeteer-core": "^24.36.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.1",
    "puppeteer": "^24.0.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}