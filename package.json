{
  "name": "footstars-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "server": "npm run server -w @field-battle/server",
    "client": "npm run dev -w field-battle-client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "npm run test -w @field-battle/server",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}